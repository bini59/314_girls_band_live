{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "girls-band-live",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "band-live.bini59.dev/*", "zone_name": "bini59.dev" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "girls-band-live",
      "database_id": "f9121d39-17f1-49dc-bce3-e2c85e5edbda",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "minify": true
}
