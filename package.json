{
  "name": "girls-band-live",
  "version": "0.7.0",
  "private": true,
  "description": "애니/게임 기반 걸즈밴드 라이브 일정 아카이브",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "opennextjs-cloudflare preview",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "wrangler d1 migrations apply DB --local",
    "prepare": "husky",
    "db:seed": "tsx prisma/seed.ts",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "typegen": "wrangler types",
    "test:worker": "tsx scripts/smoke-worker.ts"
  },
  "dependencies": {
    "@bini59/design": "github:bini59/324_bini59_design#cb24cb4",
    "@next/third-parties": "^15.5.28",
    "@opennextjs/cloudflare": "1.14.8",
    "@prisma/adapter-d1": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.28",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "miniflare": "^4.20260730.0",
    "prisma": "7.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.3"
  },
  "pnpm": {
    "overrides": {
      "@ast-grep/napi": "0.41.0"
    }
  }
}
